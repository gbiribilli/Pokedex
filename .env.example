# Modelo de configuracao de variaveis de ambiente
# Copie este arquivo para .env e preencha com suas configuracoes caso deseje personalizar

# URI de conexao ao MongoDB (padrao local ou Atlas)
MONGO_URI=mongodb://localhost:27017

# Parametros de conexao ao PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
